SLACK_SIGNING_SECRET=your-signing-secret-here
SLACK_BOT_TOKEN=your-bot-token-here
# Only used by the agent's search tool — search.messages has no bot-token equivalent.
SLACK_USER_TOKEN=your-user-token-here

# Channel whitelisting lives in constants.py's WHITELISTED_CHANNELS, not here.

# Asana Personal Access Token — AsanaClientService calls the Asana REST API directly
# with this from Django (custom tools). Workspace/project whitelisting lives in
# constants.py's WHITELISTED_ASANA_WORKSPACES/WHITELISTED_ASANA_PROJECTS, not here.
ASANA_ACCESS_TOKEN=your-asana-personal-access-token-here

# Claude Managed Agents. Create the agent and environment once from cma/*.yaml
# with the `ant` CLI, then paste the returned IDs here.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CMA_AGENT_ID=
CMA_ENVIRONMENT_ID=
CMA_VAULT_ID=
CMA_SESSION_BUDGET_CENTS=200

# Created via `ant beta:memory-stores create`, mounted read_write in every new
# session (AgentSessionCreateService._resources). General-purpose Slack agent
# cache, empty and unused for now. Optional: leave blank and it's simply not
# attached.
CMA_SLACK_MEMORY_STORE_ID=

# Created via `ant beta:memory-stores create`, mounted read_only with a
# must-read instruction in every new session. Holds /channels.md, an empty
# placeholder for now — no sync logic writes the actual channel list to it
# yet. Optional: leave blank and it's simply not attached.
CMA_WHITELISTED_CHANNELS=

# Created via `ant beta:memory-stores create`, mounted read_write in every new
# session. Holds standing instructions/preferences the user has given the
# agent, global to the whole workspace. The agent reads and writes it itself.
# Optional: leave blank and it's simply not attached.
CMA_INSTRUCTIONS_MEMORY_STORE_ID=

POSTGRES_DB=slack_cma
POSTGRES_USER=slack_cma
POSTGRES_PASSWORD=slack_cma
POSTGRES_PORT=5432

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

DATABASE_URL=postgres://slack_cma:slack_cma@localhost:5432/slack_cma

NGROK_AUTHTOKEN=your-ngrok-authtoken-here
NGROK_WEB_PORT=4040
DJANGO_PORT=8000

# korotovsky/slack-mcp-server (docker-compose.yml's slack-mcp-server
# service), tunneled by the same ngrok agent above. The bearer credential the
# CMA session presents to it — put the matching value in the CMA_VAULT_ID
# vault, not here, since Django never talks to this server directly.
SLACK_MCP_API_KEY=your-slack-mcp-server-bearer-key-here
SLACK_MCP_PORT=3001